---
const socialLinks = [
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/spraygunner/?hl=en',
    icon: '<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>',
  },
  {
    label: 'YouTube',
    href: 'https://www.youtube.com/@SprayGunner',
    icon: '<path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>',
  },
  {
    label: 'Facebook',
    href: 'https://www.facebook.com/spraygunner/',
    icon: '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  },
];
---
<div class="bg-surface-dark border-b border-white/10">
  <div class="mx-auto max-w-wide px-5 py-2 flex items-center justify-start gap-2 relative">
    <p class="text-gray-300 text-[0.8rem] text-left">
      <span class="text-accent font-bold">+</span>
      Airbrush.Gallery Your #1 Airbrush Learning Hub. Free Tutorials, Reviews &amp; Guides.
    </p>
    <ul class="max-[640px]:hidden list-none m-0 p-0 flex items-center gap-3.5 absolute right-5 top-1/2 -translate-y-1/2">
      {socialLinks.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener" aria-label={social.label} class="block text-gray-400 hover:text-accent hover:no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={social.icon} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</div>
