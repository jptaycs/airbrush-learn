---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories } from '../data/categories.js';
import { estimateReadMinutes } from '../lib/readTime.js';
import { sortArticlesNewestFirst } from '../lib/sortArticles.js';
import articles from '../data/articles.json';
import gallery from '../data/gallery.json';
import { SHOW_GALLERY } from '../lib/featureFlags.js';

const published = articles.filter((a) => a.status !== 'draft');
const sorted = sortArticlesNewestFirst(published);

const featured = sorted[0];
const featuredCat = featured ? categories.find((c) => c.slug === featured.category) : null;
const featuredReadMinutes = featured ? estimateReadMinutes(featured.content_html) : 0;
const latestArticles = sorted.slice(0, 3);

const byCategory = (slug) => sorted.filter((a) => a.category === slug);

const beginnerArticles = byCategory('beginner').slice(0, 3);

const categoryCounts = categories.map((cat) => ({
  ...cat,
  count: sorted.filter((a) => a.category === cat.slug).length,
}));

const galleryPieceCount = gallery.length;
const galleryCategoryCount = new Set(gallery.map((p) => p.category)).size;

// "Browse by Category" defaults to a 9-card grid (one card per category,
// its latest article — byCategory() is already newest-first). Picking a
// category button swaps in a grid of that category's own articles instead.
// The swap itself is plain JS in PageInteractions.astro; every panel but
// "all" starts `hidden` in the markup below so the default view is correct
// even before JS runs.
const categoryArticles = categories.map((cat) => ({
  ...cat,
  articles: byCategory(cat.slug),
}));
const MAX_PER_CATEGORY_PANEL = 9;

const stepIcons = [
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><circle cx="9" cy="6" r="2"/><line x1="4" y1="12" x2="20" y2="12"/><circle cx="15" cy="12" r="2"/><line x1="4" y1="18" x2="20" y2="18"/><circle cx="7" cy="18" r="2"/></svg>',
  '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 1 0-5.4 5.4L4 17v3h3l5.3-5.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2-2 2.5-2.5z"/></svg>',
];

// Curated highlight set for the homepage bento grid — a fixed 7-tile layout.
// The full 17-discipline breakdown lives at /gallery.
const homeGalleryTiles = [
  { label: 'Automotive', slug: 'automotive', class: 'col-start-1 row-start-1 row-span-3' },
  { label: 'Fine Art', slug: 'fine-art', class: 'col-start-2 col-span-2 row-start-1' },
  { label: 'Fabric', slug: 'fabric', class: 'col-start-4 row-start-1 row-span-2' },
  { label: 'Miniatures', slug: 'miniatures', class: 'col-start-2 row-start-2' },
  { label: 'Cosplay', slug: 'cosplay', class: 'col-start-3 row-start-2' },
  { label: 'Scale Models', slug: 'scale-models', class: 'col-start-2 col-span-2 row-start-3' },
  { label: 'Body Art', slug: 'body-art', class: 'col-start-4 row-start-3' },
];
---
<BaseLayout
  title="Airbrush Learn — Tutorials, Reviews & Buying Guides for Airbrush Artists"
  description="Free airbrush tutorials, honest gear reviews, and buying guides written for painters who spray every day."
  canonicalPath="/"
>
  <section class="bg-surface-dark py-20 max-[640px]:py-14">
    <div class="mx-auto max-w-wide px-5 grid grid-cols-[repeat(auto-fit,minmax(340px,1fr))] gap-12 items-center">
      <div>
        <span data-hero-in class="text-accent text-[0.9rem] font-semibold uppercase tracking-[0.04em]">The Airbrush Learning Hub</span>
        <h1 data-hero-in class="[animation-delay:100ms] font-serif text-white text-[3.2rem] leading-[1.05] mt-4 max-[640px]:text-[2.1rem]">Master Your Airbrush. Create Without Limits.</h1>
        <p data-hero-in class="[animation-delay:200ms] text-gray-400 text-[1.1rem] mt-5 max-w-[480px]">Tutorials, gear reviews and troubleshooting guides written by painters who spray every day.</p>
        <div data-hero-in class="[animation-delay:300ms] flex flex-wrap gap-3 mt-8">
          <a href="/category/beginner" class="inline-block rounded-full bg-accent text-white px-6 py-3 text-[0.95rem] font-semibold hover:no-underline hover:opacity-90 active:scale-95 transition-transform">Start Learning</a>
          <a href="/category/reviews" class="inline-block rounded-full border border-white/30 text-white px-6 py-3 text-[0.95rem] font-semibold hover:no-underline hover:bg-white/10 active:scale-95 transition-transform">Browse Reviews</a>
        </div>
      </div>
      {featured && (
        <a href={`/posts/${featured.slug}`} data-hero-in class="[animation-delay:400ms] block hover:no-underline">
          <div class="rotate-2 bg-white p-3 pb-5 rounded shadow-[0_20px_50px_rgba(0,0,0,0.4)] transition-transform duration-300 hover:rotate-0 hover:-translate-y-1.5 hover:scale-[1.02]">
            <div class="relative overflow-hidden rounded-sm">
              <span class="absolute top-3 left-3 z-10 text-[0.65rem] text-white uppercase tracking-[0.05em] font-bold bg-accent rounded-full px-2.5 py-1">Featured</span>
              <img src={`/images/${featured.slug}.png`} alt={featured.title} width="600" height="400" class="aspect-[3/2] object-cover w-full transition-transform duration-500 ease-out hover:scale-125" />
            </div>
            <div class="pt-4 px-1">
              {featuredCat && <span class="block text-[0.7rem] text-muted uppercase tracking-[0.05em] font-bold mb-1.5">{featuredCat.label}</span>}
              <h2 class="font-serif text-ink text-[1.15rem] leading-snug">{featured.title}</h2>
              <span class="block mt-2 text-[0.78rem] text-muted">{featured.published_date} · {featuredReadMinutes} min read</span>
            </div>
          </div>
        </a>
      )}
    </div>
  </section>

  <section class="py-16 overflow-hidden">
    <div class="mx-auto max-w-wide px-5">
      <div class="text-center mb-10">
        <h2 class="font-serif text-ink text-[2rem]">Ten ways in.</h2>
        <p class="mt-2 text-muted text-[1rem] max-w-[480px] mx-auto">Every article lives in exactly one category, so you always know where to look next.</p>
      </div>
    </div>
    <div data-reveal class="relative [mask-image:linear-gradient(to_right,transparent,black_64px,black_calc(100%-64px),transparent)] max-[640px]:[mask-image:linear-gradient(to_right,transparent,black_24px,black_calc(100%-24px),transparent)]">
      <div class="marquee-track flex w-max gap-3.5 hover:[animation-play-state:paused]">
        {[...categoryCounts, ...categoryCounts].map((cat, i) => (
          <a
            href={`/category/${cat.slug}`}
            aria-hidden={i >= categoryCounts.length ? 'true' : undefined}
            tabindex={i >= categoryCounts.length ? -1 : undefined}
            class="block w-[280px] flex-none p-7 rounded-xl bg-surface-dark hover:no-underline hover:opacity-90 hover:scale-[1.02] transition-transform"
          >
            <span class="block font-serif text-white text-[1.2rem]">{cat.label}</span>
            <span class="block mt-2 text-gray-400 text-[0.9rem]">{cat.description}</span>
            <span class="block mt-4 font-mono text-[0.7rem] text-accent font-semibold">{cat.count} article{cat.count === 1 ? '' : 's'}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-bg-alt py-16">
    <div class="mx-auto max-w-wide px-5">
      <h2 class="font-serif text-ink text-[2rem] mb-8">Latest Articles</h2>
      {latestArticles.length === 0 ? (
        <div class="text-center py-16 px-5 text-muted">
          <p>New articles are on the way — check back soon.</p>
        </div>
      ) : (
        <div data-reveal-group class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-7">
          {latestArticles.map((article) => (
            <ArticleCard
              slug={article.slug}
              title={article.title}
              excerpt={article.excerpt}
              published_date={article.published_date}
              category={article.category}
              content_html={article.content_html}
            />
          ))}
        </div>
      )}
    </div>
  </section>

  {beginnerArticles.length > 0 && (
    <section class="bg-surface-dark py-16">
      <div class="mx-auto max-w-wide px-5 text-center">
        <span class="text-accent text-[0.9rem] font-semibold italic">Start Here</span>
        <h2 class="font-serif text-white text-[2rem] mt-2">New to Airbrushing?</h2>
        <p class="text-gray-400 text-[1.05rem] mt-3 max-w-[480px] mx-auto">Follow these steps and you'll be painting like a pro.</p>
        <div data-reveal-group class="grid grid-cols-[repeat(auto-fit,minmax(240px,1fr))] gap-5 mt-10 text-left">
          {beginnerArticles.map((article, i) => (
            <a href={`/posts/${article.slug}`} data-reveal class="block p-7 rounded-xl border border-white/10 bg-white/5 hover:no-underline hover:bg-white/10 hover:-translate-y-0.5 transition-transform">
              <div class="flex items-start justify-between">
                <span class="block font-mono text-[1.6rem] font-bold text-accent">0{i + 1}</span>
                <span class="text-accent" set:html={stepIcons[i]} />
              </div>
              <span class="block mt-3 font-serif text-white text-[1.05rem] leading-snug">{article.title}</span>
              <span class="block mt-3 text-accent font-semibold text-[0.85rem]">Read &rarr;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="py-16">
    <div class="mx-auto max-w-wide px-5">
      <div class="rounded-xl bg-bg-alt p-10 max-[640px]:p-6 flex flex-wrap items-center justify-between gap-6">
        <div class="max-w-[480px]">
          <span class="text-accent-dark italic text-[0.9rem] font-semibold">Not sure what to buy?</span>
          <h2 class="font-serif text-ink text-[1.8rem] mt-2">Find your airbrush setup in 60 seconds.</h2>
          <p class="mt-2 text-muted text-[1rem]">Answer a few quick questions and we'll match you to the right airbrush, compressor, and accessories.</p>
        </div>
        <a href="/gear-advisor" class="inline-block rounded-full bg-accent text-white px-6 py-3 text-[0.95rem] font-semibold hover:no-underline hover:opacity-90 active:scale-95 transition-transform">Take the Gear Quiz &rarr;</a>
      </div>
    </div>
  </section>

  <section class="bg-bg-alt py-16">
    <div class="mx-auto max-w-wide px-5">
      <div class="text-center mb-10">
        <h2 class="font-serif text-ink text-[2rem]">Browse by Category</h2>
        <p class="mt-2 text-muted text-[1rem] max-w-[480px] mx-auto">Showing each category's latest article — pick a category to see more.</p>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-10" data-cat-selector>
        <label class="scroll-mt-24 cursor-pointer rounded-full border border-border px-4 py-2 text-[0.85rem] font-semibold text-ink hover:bg-bg-alt transition-colors has-[:checked]:bg-accent has-[:checked]:text-white has-[:checked]:border-accent">
          <input type="radio" name="cat-filter" value="all" checked class="sr-only" />
          All
        </label>
        {categoryArticles.map((cat) => (
          <label class="scroll-mt-24 cursor-pointer rounded-full border border-border px-4 py-2 text-[0.85rem] font-semibold text-ink hover:bg-bg-alt transition-colors has-[:checked]:bg-accent has-[:checked]:text-white has-[:checked]:border-accent">
            <input type="radio" name="cat-filter" value={cat.slug} class="sr-only" />
            {cat.label}
          </label>
        ))}
      </div>

      <div data-panel="all">
        <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-7">
          {categoryArticles.filter((cat) => cat.articles[0]).map((cat) => {
            const a = cat.articles[0];
            return (
              <ArticleCard
                slug={a.slug}
                title={a.title}
                excerpt={a.excerpt}
                published_date={a.published_date}
                category={a.category}
                content_html={a.content_html}
              />
            );
          })}
        </div>
      </div>

      {categoryArticles.map((cat) => (
        <div data-panel={cat.slug} hidden>
          {cat.articles.length === 0 ? (
            <p class="text-center text-muted py-10">New articles are on the way — check back soon.</p>
          ) : (
            <div class="grid grid-cols-[repeat(auto-fill,minmax(280px,1fr))] gap-7">
              {cat.articles.slice(0, MAX_PER_CATEGORY_PANEL).map((article) => (
                <ArticleCard
                  slug={article.slug}
                  title={article.title}
                  excerpt={article.excerpt}
                  published_date={article.published_date}
                  category={article.category}
                  content_html={article.content_html}
                />
              ))}
            </div>
          )}
          {cat.articles.length > MAX_PER_CATEGORY_PANEL && (
            <div class="text-center mt-8">
              <a href={`/category/${cat.slug}`} class="inline-block rounded-full border border-border text-ink px-5 py-2.5 text-[0.9rem] font-semibold hover:no-underline hover:bg-bg-alt">View all {cat.label} articles &rarr;</a>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="bg-accent-dark py-16">
    <div class="mx-auto max-w-wide px-5 text-center">
      <span class="text-white/95 italic text-[0.9rem] font-semibold">Stay Sharp</span>
      <h2 class="font-serif text-white text-[2rem] mt-2 max-w-[560px] mx-auto">Get airbrush tips, gear reviews &amp; tutorials in your inbox.</h2>
      <div class="flex flex-wrap justify-center gap-2 mt-7 max-w-[440px] mx-auto">
        <input type="email" placeholder="Enter your email address" class="flex-1 min-w-[220px] rounded-full px-5 py-3 text-[0.95rem] border-0" />
        <button type="button" class="rounded-full bg-ink text-white px-6 py-3 text-[0.95rem] font-semibold active:scale-95 transition-transform">Subscribe</button>
      </div>
      <p class="text-white/85 text-[0.78rem] mt-3">No spam. Unsubscribe anytime.</p>
    </div>
  </section>

  {SHOW_GALLERY && (
    <section class="bg-bg-alt py-16">
      <div class="mx-auto max-w-wide px-5">
        <div class="flex flex-wrap items-end justify-between gap-4 mb-8">
          <div>
            <span class="text-accent-dark italic text-[0.9rem] font-semibold">Community Gallery</span>
            <h2 class="font-serif text-ink text-[2rem] mt-2">Airbrush Art Gallery</h2>
            <p class="text-muted text-[1rem] mt-2 max-w-[480px]">Real work from real airbrush artists — automotive, miniatures, cosplay &amp; more.</p>
          </div>
          <a href="/gallery" class="inline-block rounded-full border border-border text-ink px-5 py-2.5 text-[0.9rem] font-semibold hover:no-underline hover:bg-bg-alt">See Full Gallery &rarr;</a>
        </div>
        <div data-reveal-group class="grid grid-cols-4 [grid-template-rows:repeat(3,1fr)] aspect-[21/8] gap-3.5 max-[768px]:grid-cols-2 max-[768px]:aspect-auto max-[768px]:[grid-template-rows:none]">
          {homeGalleryTiles.map((tile) => (
            <a href={`/gallery/${tile.slug}`} data-reveal class={`relative rounded-xl overflow-hidden bg-bg flex items-end p-4 transition-transform duration-300 hover:scale-[1.03] hover:no-underline ${tile.class} max-[768px]:col-span-1 max-[768px]:row-span-1 max-[768px]:col-start-auto max-[768px]:row-start-auto max-[768px]:aspect-[4/3]`}>
              <img src={`/images/gallery/${tile.slug}.jpg`} alt={tile.label} loading="lazy" class="absolute inset-0 w-full h-full object-cover" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/0 to-transparent"></div>
              <span class="relative text-[0.85rem] font-semibold text-white">{tile.label}</span>
            </a>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-4 mt-8">
          <a href="/gallery" class="inline-block rounded-full bg-accent text-white px-6 py-3 text-[0.95rem] font-semibold hover:no-underline hover:opacity-90">Browse All Artwork &rarr;</a>
          <a href="/gallery/submit" class="inline-block rounded-full border border-border text-ink px-6 py-3 text-[0.95rem] font-semibold hover:no-underline hover:bg-bg-alt">Upload Artwork</a>
          <span class="text-muted text-[0.85rem]">{galleryPieceCount} piece{galleryPieceCount === 1 ? '' : 's'} across {galleryCategoryCount} discipline{galleryCategoryCount === 1 ? '' : 's'}</span>
        </div>
      </div>
    </section>
  )}

  <section class="bg-surface-dark py-20">
    <div data-reveal class="mx-auto max-w-wide px-5 text-center">
      <span class="text-accent italic text-[0.9rem] font-semibold">Ready to Level Up?</span>
      <h2 class="font-serif text-white text-[2.2rem] mt-2">Shop the gear that pros trust.</h2>
      <p class="text-gray-400 text-[1.05rem] mt-3 max-w-[480px] mx-auto">Airbrushes, compressors, paints &amp; accessories — everything you need in one place.</p>
      <a href="https://spraygunner.com/?utm_source=airbrushlearn&utm_medium=cta" target="_blank" rel="noopener" class="inline-block mt-7 rounded-full bg-accent text-white px-7 py-3.5 text-[0.95rem] font-semibold hover:no-underline hover:opacity-90 active:scale-95 transition-transform">Shop the Gear at SprayGunner &rarr;</a>
    </div>
  </section>
</BaseLayout>
