---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories.js';
import { SHOW_GALLERY } from '../lib/featureFlags.js';
---
<BaseLayout
  title="Admin — Airbrush Learn"
  description="Article management"
  canonicalPath="/admin"
  noindex={true}
>
  <section class="mx-auto max-w-wide px-5 py-12">
    <div data-login-panel class="min-h-[60vh] flex items-center justify-center">
      <div class="w-full max-w-sm bg-bg border border-border rounded-xl shadow-[0_8px_24px_rgba(0,0,0,0.06)] p-8 text-center">
        <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-accent/10">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
        </div>
        <h1 class="font-serif text-ink text-[1.5rem] mb-1.5">Admin Access</h1>
        <p class="text-muted text-[0.85rem] mb-6">Enter the password to manage articles.</p>
        <div class="text-left">
          <label class="block text-[0.8rem] font-semibold text-ink mb-1.5" for="admin-password">Password</label>
          <input id="admin-password" type="password" autocomplete="current-password" placeholder="••••••••" class="w-full rounded-lg border border-border px-3.5 py-2.5 text-[0.95rem] focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
        </div>
        <button type="button" data-login-btn class="mt-4 w-full rounded-full bg-accent text-white px-4 py-2.5 font-semibold hover:opacity-90 active:scale-[0.98] transition-transform">Log in</button>
        <p data-login-error class="hidden text-red-600 text-[0.82rem] mt-3"></p>
      </div>
    </div>

    <div data-admin-panel class="hidden">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <div>
          <h1 class="font-serif text-ink text-[1.8rem]">Admin</h1>
          <p data-status-msg class="text-muted text-[0.85rem] mt-1"></p>
        </div>
        <div class="flex items-center gap-2">
          <div data-header-control="articles" class="flex items-center gap-2">
            <label class="text-[0.8rem] text-muted font-semibold" for="article-sort">Sort</label>
            <select id="article-sort" data-sort-select class="rounded-full border border-border text-ink px-3.5 py-2 text-[0.85rem] font-semibold hover:bg-bg-alt transition-colors focus:outline-none focus:ring-2 focus:ring-accent/40">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="title-asc">Title (A&ndash;Z)</option>
              <option value="title-desc">Title (Z&ndash;A)</option>
            </select>
          </div>
          <div data-header-control="topics" class="hidden items-center gap-2">
            <label class="text-[0.8rem] text-muted font-semibold" for="topic-status-filter">Filter</label>
            <select id="topic-status-filter" data-topic-status-filter class="rounded-full border border-border text-ink px-3.5 py-2 text-[0.85rem] font-semibold hover:bg-bg-alt transition-colors focus:outline-none focus:ring-2 focus:ring-accent/40">
              <option value="all">All statuses</option>
              <option value="Not started">Not started</option>
              <option value="Published">Published</option>
              <option value="Blocked">Blocked</option>
            </select>
          </div>
          <button type="button" data-refresh-btn class="inline-flex items-center gap-1.5 rounded-full border border-border text-ink px-4 py-2 text-[0.85rem] font-semibold hover:bg-bg-alt transition-colors">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>
            Refresh
          </button>
        </div>
      </div>

      <div class="flex gap-2 mb-6 border-b border-border">
        <button type="button" data-tab-btn="articles" class="px-4 py-2.5 text-[0.9rem] font-semibold border-b-2 border-accent text-accent-dark">Articles</button>
        {SHOW_GALLERY && (
          <button type="button" data-tab-btn="gallery" class="px-4 py-2.5 text-[0.9rem] font-semibold border-b-2 border-transparent text-muted hover:text-ink">Gallery Submissions</button>
        )}
        <button type="button" data-tab-btn="topics" class="px-4 py-2.5 text-[0.9rem] font-semibold border-b-2 border-transparent text-muted hover:text-ink">Topics</button>
      </div>

      <div data-tab-panel="articles">
        <div class="rounded-xl border border-border overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-[0.88rem] border-collapse">
              <thead>
                <tr class="bg-bg-alt text-muted text-[0.72rem] uppercase tracking-wide">
                  <th class="py-3 px-4 font-semibold">Title</th>
                  <th class="py-3 px-4 font-semibold">Status</th>
                  <th class="py-3 px-4 font-semibold">Category</th>
                  <th class="py-3 px-4 font-semibold">Date</th>
                  <th class="py-3 px-4 font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody data-article-rows></tbody>
            </table>
          </div>
        </div>
      </div>

      {SHOW_GALLERY && (
        <div data-tab-panel="gallery" class="hidden">
          <div data-gallery-rows class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-5"></div>
        </div>
      )}

      <div data-tab-panel="topics" class="hidden">
        <div class="flex items-center justify-between mb-4 gap-4">
          <p class="text-muted text-[0.82rem]">Drag rows by the <span aria-hidden="true">⠿</span> handle to reorder. The n8n pipeline picks the first <span class="font-semibold">Not started</span> topic from the top of this list — reordering changes what gets generated next. Dragging is disabled while a status filter is active — switch back to "All statuses" to reorder.</p>
          <button type="button" data-add-topic-btn class="rounded-full bg-accent text-white px-4 py-2 text-[0.85rem] font-semibold hover:opacity-90 transition-opacity whitespace-nowrap">+ Add Topic</button>
        </div>
        <div class="rounded-xl border border-border overflow-hidden">
          <div class="overflow-x-auto">
            <table class="w-full text-left text-[0.88rem] border-collapse">
              <thead>
                <tr class="bg-bg-alt text-muted text-[0.72rem] uppercase tracking-wide">
                  <th class="py-3 px-4 font-semibold w-8"></th>
                  <th class="py-3 px-4 font-semibold">#</th>
                  <th class="py-3 px-4 font-semibold">Category</th>
                  <th class="py-3 px-4 font-semibold">Article Title</th>
                  <th class="py-3 px-4 font-semibold">Priority</th>
                  <th class="py-3 px-4 font-semibold">Status</th>
                  <th class="py-3 px-4 font-semibold">Publish Date</th>
                  <th class="py-3 px-4 font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody data-topic-rows></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>

    <div data-edit-panel class="hidden mt-10">
      <div class="rounded-xl border border-border bg-bg-alt/40 p-6 sm:p-8">
        <h2 class="font-serif text-ink text-[1.3rem] mb-6">Edit article</h2>
        <form data-edit-form class="grid gap-5">
          <input type="hidden" data-field="slug" />
          <div class="grid gap-5 max-w-2xl">
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Title</span>
              <input type="text" data-field="title" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" required />
            </label>
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Excerpt</span>
              <textarea data-field="excerpt" rows="2" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow"></textarea>
            </label>
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Published date</span>
              <input type="datetime-local" data-field="published_date" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
              <span class="block text-[0.75rem] text-muted mt-1">Time is optional — existing date-only articles keep working unchanged; the public site always displays date only.</span>
            </label>
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Category</span>
              <select data-field="category" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow">
                {categories.map((c) => <option value={c.slug}>{c.label}</option>)}
              </select>
            </label>
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Status</span>
              <select data-field="status" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow">
                <option value="published">Published</option>
                <option value="draft">Draft</option>
              </select>
            </label>
            <div class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Hero image</span>
              <img data-hero-image class="w-full max-w-sm rounded-lg border border-border object-cover aspect-[3/2]" alt="Hero image preview" />
              <div class="mt-3">
                <button type="button" data-regen-image-btn class="rounded-full border border-border px-4 py-2 text-[0.85rem] font-semibold hover:bg-bg transition-colors">Regenerate Image</button>
                <div data-regen-panel class="hidden mt-3 grid gap-2 max-w-sm">
                  <textarea data-regen-prompt rows="4" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 text-[0.85rem] focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" placeholder="Image prompt"></textarea>
                  <div class="flex gap-2">
                    <button type="button" data-regen-generate-btn class="rounded-full bg-accent text-white px-4 py-2 text-[0.85rem] font-semibold hover:opacity-90 transition-opacity">Generate</button>
                    <button type="button" data-regen-cancel-btn class="rounded-full border border-border px-4 py-2 text-[0.85rem] font-semibold hover:bg-bg transition-colors">Cancel</button>
                  </div>
                  <p data-regen-status class="text-[0.8rem] text-muted"></p>
                </div>
              </div>
            </div>
          </div>
          <div class="grid gap-5 lg:grid-cols-2">
            <label class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Body (raw HTML)</span>
              <textarea data-field="content_html" rows="20" class="w-full h-full rounded-lg border border-border bg-bg px-3.5 py-2.5 font-mono text-[0.8rem] focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow"></textarea>
            </label>
            <div class="block">
              <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Preview</span>
              <div data-edit-preview class="prose prose-site max-w-prose h-[calc(100%-1.6rem)] overflow-y-auto rounded-lg border border-border bg-bg px-4 py-3">
                <h1 data-preview-title></h1>
                <div data-preview-body></div>
              </div>
            </div>
          </div>
          <div class="flex gap-3">
            <button type="submit" class="rounded-full bg-accent text-white px-5 py-2.5 font-semibold hover:opacity-90 transition-opacity">Save</button>
            <button type="button" data-cancel-edit class="rounded-full border border-border px-5 py-2.5 font-semibold hover:bg-bg transition-colors">Cancel</button>
          </div>
          <p data-edit-error class="hidden text-red-600 text-[0.85rem]"></p>
        </form>
      </div>
    </div>

    <div data-topic-edit-panel class="hidden mt-10">
      <div class="rounded-xl border border-border bg-bg-alt/40 p-6 sm:p-8">
        <h2 class="font-serif text-ink text-[1.3rem] mb-6">Edit topic</h2>
        <form data-topic-edit-form class="grid gap-5 max-w-2xl">
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">#</span>
            <input type="number" data-tfield="id" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" required />
            <span class="block text-[0.75rem] text-muted mt-1">Unique topic number — matches what n8n references. Don't change this on an existing topic.</span>
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Category</span>
            <input type="text" data-tfield="category" placeholder="e.g. Buying Guides" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Search Intent</span>
            <input type="text" data-tfield="search_intent" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Article Title</span>
            <input type="text" data-tfield="article_title" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" required />
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Target Keyword</span>
            <input type="text" data-tfield="target_keyword" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Priority</span>
            <select data-tfield="priority" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow">
              <option value="High">High</option>
              <option value="Medium">Medium</option>
              <option value="Low">Low</option>
            </select>
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Status</span>
            <select data-tfield="status" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow">
              <option value="Not started">Not started</option>
              <option value="Published">Published</option>
              <option value="Blocked">Blocked</option>
            </select>
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Publish Date</span>
            <input type="date" data-tfield="publish_date" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow" />
          </label>
          <label class="block">
            <span class="block text-[0.8rem] font-semibold text-ink mb-1.5">Notes</span>
            <textarea data-tfield="notes" rows="2" class="w-full rounded-lg border border-border bg-bg px-3.5 py-2.5 focus:outline-none focus:ring-2 focus:ring-accent/40 focus:border-accent transition-shadow"></textarea>
          </label>
          <div class="flex gap-3">
            <button type="submit" class="rounded-full bg-accent text-white px-5 py-2.5 font-semibold hover:opacity-90 transition-opacity">Save</button>
            <button type="button" data-cancel-topic-edit class="rounded-full border border-border px-5 py-2.5 font-semibold hover:bg-bg transition-colors">Cancel</button>
          </div>
          <p data-topic-edit-error class="hidden text-red-600 text-[0.85rem]"></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { sortArticlesNewestFirst } from '../lib/sortArticles.js';

  const PASSWORD_KEY = 'admin_password';
  const loginPanel = document.querySelector('[data-login-panel]');
  const adminPanel = document.querySelector('[data-admin-panel]');
  const editPanel = document.querySelector('[data-edit-panel]');
  const passwordInput = document.getElementById('admin-password');
  const loginBtn = document.querySelector('[data-login-btn]');
  const loginError = document.querySelector('[data-login-error]');
  const statusMsg = document.querySelector('[data-status-msg]');
  const refreshBtn = document.querySelector('[data-refresh-btn]');
  const sortSelect = document.querySelector('[data-sort-select]');
  const rowsBody = document.querySelector('[data-article-rows]');
  const editForm = document.querySelector('[data-edit-form]');
  const editError = document.querySelector('[data-edit-error]');
  const cancelEditBtn = document.querySelector('[data-cancel-edit]');
  const previewTitle = document.querySelector('[data-preview-title]');
  const previewBody = document.querySelector('[data-preview-body]');
  const heroImage = document.querySelector('[data-hero-image]');
  const regenImageBtn = document.querySelector('[data-regen-image-btn]');
  const regenPanel = document.querySelector('[data-regen-panel]');
  const regenPrompt = document.querySelector('[data-regen-prompt]');
  const regenGenerateBtn = document.querySelector('[data-regen-generate-btn]');
  const regenCancelBtn = document.querySelector('[data-regen-cancel-btn]');
  const regenStatus = document.querySelector('[data-regen-status]');
  const tabButtons = document.querySelectorAll('[data-tab-btn]');
  const tabPanels = document.querySelectorAll('[data-tab-panel]');
  const headerControls = document.querySelectorAll('[data-header-control]');
  // The active tab is already tracked by the DOM (exactly one [data-tab-panel]
  // lacks `hidden` at a time) — deriving it here instead of mirroring it into
  // a separate variable means there's only one source of truth to go stale.
  const getActiveTab = () =>
    document.querySelector('[data-tab-panel]:not(.hidden)')?.dataset.tabPanel || 'articles';
  const topicStatusFilterSelect = document.querySelector('[data-topic-status-filter]');
  let topicStatusFilter = 'all';
  const galleryRows = document.querySelector('[data-gallery-rows]');
  const topicRows = document.querySelector('[data-topic-rows]');
  const addTopicBtn = document.querySelector('[data-add-topic-btn]');
  const topicEditPanel = document.querySelector('[data-topic-edit-panel]');
  const topicEditForm = document.querySelector('[data-topic-edit-form]');
  const topicEditError = document.querySelector('[data-topic-edit-error]');
  const cancelTopicEditBtn = document.querySelector('[data-cancel-topic-edit]');

  let currentSha = null;
  let currentArticles = [];
  let currentTopicsSha = null;
  let currentTopics = [];

  // published_date has no time component, so "newest"/"oldest" reuse the same
  // array-position tiebreak as the public site (later in articles.json = more
  // recently added) rather than a plain, ambiguous date-string sort.
  const sortedForDisplay = () => {
    switch (sortSelect.value) {
      case 'oldest':
        return [...sortArticlesNewestFirst(currentArticles)].reverse();
      case 'title-asc':
        return [...currentArticles].sort((a, b) => (a.title || '').localeCompare(b.title || ''));
      case 'title-desc':
        return [...currentArticles].sort((a, b) => (b.title || '').localeCompare(a.title || ''));
      case 'newest':
      default:
        return sortArticlesNewestFirst(currentArticles);
    }
  };

  const getPassword = () => sessionStorage.getItem(PASSWORD_KEY) || '';

  const api = async (path, options = {}) => {
    return fetch(`/.netlify/functions/${path}`, {
      ...options,
      headers: {
        'x-admin-password': getPassword(),
        'content-type': 'application/json',
        ...(options.headers || {}),
      },
    });
  };

  // Same stroke-icon style as the Refresh button's svg elsewhere in this
  // file, just spinning via Tailwind's built-in animate-spin utility.
  const spinnerSvg = (size = 14) =>
    `<svg class="animate-spin" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-9-9"/></svg>`;

  // For actions triggered by one specific button (login, refresh, a row's
  // Edit/Delete/Approve/etc, a form's Save). Swaps the button to a spinner
  // and disables it for the duration of `fn`. On the success path the
  // button is usually destroyed by the re-render that follows (loadArticles/
  // loadTopics/loadPendingSubmissions replace the whole table via
  // innerHTML), so the `document.body.contains` check skips restoring a
  // detached node; on an early-return error path the row/form stays put,
  // so the button needs its original label and enabled state back.
  const withButtonLoading = async (button, fn) => {
    if (!button) return fn();
    const originalHtml = button.innerHTML;
    const originalDisabled = button.disabled;
    button.disabled = true;
    button.innerHTML = spinnerSvg(14);
    try {
      return await fn();
    } finally {
      if (document.body.contains(button)) {
        button.innerHTML = originalHtml;
        button.disabled = originalDisabled;
      }
    }
  };

  // For actions with no single button to spinner-ify: loading a tab's data
  // on first switch/refresh, and the topics drag-and-drop reorder. Overlays
  // a centered spinner on `container` (which also blocks clicks under it,
  // preventing a second action mid-request) for the duration of `fn`.
  const withContainerLoading = async (container, fn) => {
    if (!container) return fn();
    container.classList.add('relative');
    const overlay = document.createElement('div');
    overlay.className = 'absolute inset-0 bg-bg/70 flex items-center justify-center z-20 rounded-xl';
    overlay.innerHTML = `<span class="text-accent">${spinnerSvg(28)}</span>`;
    container.appendChild(overlay);
    try {
      return await fn();
    } finally {
      overlay.remove();
    }
  };

  // Every write endpoint (admin-save/delete, topics-save/delete/reorder)
  // does a GitHub sha compare-and-swap and 409s if the file moved since
  // this tab last loaded it — trivially common with a single operator
  // clicking multiple actions in a row, two tabs open, or n8n writing to
  // topics.json around the same time. Refresh the sha and silently retry
  // instead of surfacing that as an error the admin has to manually act on.
  const refreshSha = async (kind) => {
    const res = await api(kind === 'topics' ? 'topics-list' : 'admin-list');
    if (!res.ok) return false;
    const data = await res.json();
    if (kind === 'topics') {
      currentTopics = data.topics;
      currentTopicsSha = data.sha;
    } else {
      currentArticles = data.articles;
      currentSha = data.sha;
    }
    return true;
  };

  const withShaRetry = async (kind, requestFn, attempts = 3) => {
    let res = await requestFn();
    for (let i = 0; i < attempts - 1 && res.status === 409; i++) {
      if (!(await refreshSha(kind))) break;
      res = await requestFn();
    }
    return res;
  };

  const escapeHtml = (str) =>
    String(str ?? '').replace(/[&<>"']/g, (c) => ({
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    }[c]));

  // Table display only — the stored value stays whatever it already was
  // (date-only or date+time); this just makes a time component visible
  // when one is present, without touching what's saved.
  const formatAdminDate = (value) => {
    if (!value) return '—';
    return value.includes('T') ? value.replace('T', ' ') : value;
  };

  let pendingSubmissions = [];

  const renderGalleryRows = () => {
    if (pendingSubmissions.length === 0) {
      galleryRows.innerHTML = `<p class="col-span-full py-12 text-center text-muted">No pending submissions.</p>`;
      return;
    }
    galleryRows.innerHTML = pendingSubmissions
      .map(
        (s) => `
        <div class="rounded-xl border border-border overflow-hidden">
          <img src="${escapeHtml(s.imageDataUrl)}" alt="${escapeHtml(s.title)}" class="w-full aspect-[4/3] object-cover" />
          <div class="p-4">
            <h3 class="font-serif text-ink text-[1rem] truncate" title="${escapeHtml(s.title)}">${escapeHtml(s.title)}</h3>
            <p class="text-muted text-[0.8rem] mt-1">${escapeHtml(s.artistName)} &middot; ${escapeHtml(s.discipline)}</p>
            <p class="text-muted text-[0.75rem] mt-0.5">${escapeHtml(s.submittedAt || '')}</p>
            <div class="flex gap-2 mt-3">
              <button type="button" data-approve="${escapeHtml(s.id)}" class="rounded-full bg-accent text-white px-3 py-1.5 text-[0.78rem] font-semibold hover:opacity-90 transition-opacity">Approve</button>
              <button type="button" data-reject="${escapeHtml(s.id)}" class="rounded-full border border-red-200 text-red-600 px-3 py-1.5 text-[0.78rem] font-semibold hover:bg-red-50 transition-colors">Reject</button>
            </div>
          </div>
        </div>
      `
      )
      .join('');
  };

  const loadPendingSubmissions = async () => {
    const res = await api('gallery-pending-list');
    if (!res.ok) {
      galleryRows.innerHTML = `<p class="col-span-full py-12 text-center text-muted">Failed to load submissions.</p>`;
      return;
    }
    const data = await res.json();
    pendingSubmissions = data.submissions;
    renderGalleryRows();
  };

  // Kept as a single constant since this table's empty/error rows need to
  // span every <th> in the thead above — three separate literals had
  // already drifted out of sync once (7 vs the table's real 8 columns)
  // before this was introduced.
  const TOPICS_COLSPAN = 8;
  const topicsEmptyRow = (message) =>
    `<tr><td colspan="${TOPICS_COLSPAN}" class="py-12 text-center text-muted">${message}</td></tr>`;

  const renderTopicRows = () => {
    if (currentTopics.length === 0) {
      topicRows.innerHTML = topicsEmptyRow('No topics yet.');
      return;
    }
    // The status filter is a display-only view — reordering only makes
    // sense against the full, unfiltered list (dragging a filtered subset
    // against hidden rows would silently scramble the real pipeline order),
    // so dragging is disabled whenever a filter narrower than "all" is active.
    const canDrag = topicStatusFilter === 'all';
    const filtered = canDrag
      ? currentTopics
      : currentTopics.filter((t) => (t.status || 'Not started') === topicStatusFilter);

    if (filtered.length === 0) {
      topicRows.innerHTML = topicsEmptyRow('No topics match this filter.');
      return;
    }
    const statusClass = (status) =>
      status === 'Published'
        ? 'bg-accent/10 text-accent-dark'
        : status === 'Blocked'
        ? 'bg-red-50 text-red-600'
        : 'bg-bg-alt text-muted';
    // Rendered in currentTopics' actual array order — that order IS the
    // pipeline's pick priority (see Fetch Topics from API -> Filter ->
    // Limit to 1 Topic in the n8n workflow), so this must never be
    // re-sorted by id or anything else for display.
    topicRows.innerHTML = filtered
      .map(
        (t) => `
        <tr class="border-t border-border hover:bg-bg-alt/60 transition-colors" draggable="${canDrag}" data-topic-row="${t.id}">
          <td class="py-3 px-4 ${canDrag ? 'text-muted cursor-grab active:cursor-grabbing' : 'text-border'}" title="${canDrag ? 'Drag to reorder' : 'Clear the filter to reorder'}" aria-hidden="true">⠿</td>
          <td class="py-3 px-4 text-muted">${t.id}</td>
          <td class="py-3 px-4 text-muted">${escapeHtml(t.category || '—')}</td>
          <td class="py-3 px-4 max-w-[280px] truncate" title="${escapeHtml(t.article_title)}">${escapeHtml(t.article_title)}</td>
          <td class="py-3 px-4 text-muted">${escapeHtml(t.priority || '—')}</td>
          <td class="py-3 px-4">
            <span class="text-[0.7rem] font-semibold uppercase px-2 py-0.5 rounded-full ${statusClass(t.status)}">${escapeHtml(t.status || 'Not started')}</span>
          </td>
          <td class="py-3 px-4 text-muted whitespace-nowrap">${escapeHtml(t.publish_date || '—')}</td>
          <td class="py-3 px-4">
            <div class="flex flex-wrap items-center gap-1.5">
              <button type="button" data-topic-edit="${t.id}" class="rounded-full border border-border px-2.5 py-1 text-[0.78rem] font-semibold text-ink hover:bg-bg-alt transition-colors">Edit</button>
              <button type="button" data-topic-delete="${t.id}" class="rounded-full border border-red-200 px-2.5 py-1 text-[0.78rem] font-semibold text-red-600 hover:bg-red-50 transition-colors">Delete</button>
            </div>
          </td>
        </tr>
      `
      )
      .join('');
  };

  const loadTopics = async () => {
    const res = await api('topics-list');
    if (!res.ok) {
      topicRows.innerHTML = topicsEmptyRow('Failed to load topics.');
      return;
    }
    const data = await res.json();
    currentTopics = data.topics;
    currentTopicsSha = data.sha;
    renderTopicRows();
  };

  // Single source of truth for "which loader owns this tab", shared by the
  // tab-click handler (which auto-loads gallery/topics data, but not
  // articles — that's already loaded at login) and the refresh button
  // (which always reloads whatever tab is currently showing). Wrapped in
  // arrow functions so this can sit above loadArticles/loadPendingSubmissions/
  // loadTopics's own `const` declarations further down without a
  // temporal-dead-zone error — none of these are invoked until a user
  // actually clicks something, by which point the whole script has run.
  const tabLoaders = {
    articles: () => loadArticles(),
    gallery: () => loadPendingSubmissions(),
    topics: () => loadTopics(),
  };

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = btn.dataset.tabBtn;
      tabButtons.forEach((b) => {
        const active = b.dataset.tabBtn === tab;
        b.classList.toggle('border-accent', active);
        b.classList.toggle('text-accent-dark', active);
        b.classList.toggle('border-transparent', !active);
        b.classList.toggle('text-muted', !active);
      });
      tabPanels.forEach((p) => {
        p.classList.toggle('hidden', p.dataset.tabPanel !== tab);
      });
      // Header controls (Sort, Topics status filter) are per-tab — each one
      // only does anything on its own tab, so show only the one that matches
      // instead of leaving a dead control visible on the others.
      headerControls.forEach((c) => {
        const show = c.dataset.headerControl === tab;
        c.classList.toggle('hidden', !show);
        c.classList.toggle('flex', show);
      });
      if (tab !== 'articles' && tabLoaders[tab]) {
        const panel = document.querySelector(`[data-tab-panel="${tab}"]`);
        withContainerLoading(panel, () => tabLoaders[tab]());
      }
    });
  });

  // galleryRows is null when SHOW_GALLERY is false (the tab/panel aren't
  // rendered at all) — guard rather than let this throw at script load.
  galleryRows?.addEventListener('click', async (e) => {
    const approveBtn = e.target.closest('[data-approve]');
    const rejectBtn = e.target.closest('[data-reject]');

    if (approveBtn) {
      const approveId = approveBtn.dataset.approve;
      await withButtonLoading(approveBtn, async () => {
        const res = await api('gallery-approve', { method: 'POST', body: JSON.stringify({ id: approveId }) });
        if (!res.ok) {
          alert(await res.text());
          return;
        }
        await loadPendingSubmissions();
      });
      return;
    }

    if (rejectBtn) {
      const rejectId = rejectBtn.dataset.reject;
      if (!confirm('Reject this submission? It will be deleted and cannot be recovered from here.')) return;
      await withButtonLoading(rejectBtn, async () => {
        const res = await api('gallery-reject', { method: 'POST', body: JSON.stringify({ id: rejectId }) });
        if (!res.ok) {
          alert(await res.text());
          return;
        }
        await loadPendingSubmissions();
      });
    }
  });

  const openTopicEdit = (id) => {
    const isNew = id === null;
    const topic = isNew
      ? { id: (currentTopics.reduce((max, t) => Math.max(max, t.id), 0) || 0) + 1, priority: 'Medium', status: 'Not started' }
      : currentTopics.find((t) => t.id === id);
    if (!topic) return;
    topicEditForm.querySelector('[data-tfield="id"]').value = topic.id;
    topicEditForm.querySelector('[data-tfield="id"]').disabled = !isNew;
    topicEditForm.querySelector('[data-tfield="category"]').value = topic.category || '';
    topicEditForm.querySelector('[data-tfield="search_intent"]').value = topic.search_intent || '';
    topicEditForm.querySelector('[data-tfield="article_title"]').value = topic.article_title || '';
    topicEditForm.querySelector('[data-tfield="target_keyword"]').value = topic.target_keyword || '';
    topicEditForm.querySelector('[data-tfield="priority"]').value = topic.priority || 'Medium';
    topicEditForm.querySelector('[data-tfield="status"]').value = topic.status || 'Not started';
    topicEditForm.querySelector('[data-tfield="publish_date"]').value = topic.publish_date || '';
    topicEditForm.querySelector('[data-tfield="notes"]').value = topic.notes || '';
    topicEditError.classList.add('hidden');
    topicEditPanel.classList.remove('hidden');
    topicEditPanel.scrollIntoView({ behavior: 'smooth' });
  };

  addTopicBtn.addEventListener('click', () => openTopicEdit(null));

  cancelTopicEditBtn.addEventListener('click', () => {
    topicEditPanel.classList.add('hidden');
  });

  topicRows.addEventListener('click', async (e) => {
    const editId = e.target.closest('[data-topic-edit]')?.dataset.topicEdit;
    const deleteBtn = e.target.closest('[data-topic-delete]');

    if (editId) {
      openTopicEdit(Number(editId));
      return;
    }

    if (deleteBtn) {
      const deleteId = deleteBtn.dataset.topicDelete;
      if (!confirm(`Delete topic #${deleteId}? This cannot be undone from here (use git revert to recover).`)) return;
      await withButtonLoading(deleteBtn, async () => {
        const res = await withShaRetry('topics', () =>
          api('topics-delete', { method: 'POST', body: JSON.stringify({ id: Number(deleteId), sha: currentTopicsSha }) })
        );
        if (!res.ok) {
          alert(await res.text());
          return;
        }
        await loadTopics();
      });
    }
  });

  // Drag-to-reorder: the row order IS the pipeline's pick-priority order
  // (see the comment in renderTopicRows), so a drop persists immediately
  // via topics-reorder rather than needing a separate "Save order" step.
  let draggedTopicId = null;

  topicRows.addEventListener('dragstart', (e) => {
    // Belt-and-suspenders: the `draggable` attribute rendered in
    // renderTopicRows() already gates this per-row while a filter is
    // active, but that guarantee lives in the render layer — checking the
    // filter again here means a row that somehow becomes draggable without
    // going through that exact render path still can't start a reorder.
    if (topicStatusFilter !== 'all') return;
    const row = e.target.closest('[data-topic-row]');
    if (!row) return;
    draggedTopicId = Number(row.dataset.topicRow);
    e.dataTransfer.effectAllowed = 'move';
  });

  topicRows.addEventListener('dragover', (e) => {
    if (draggedTopicId === null) return;
    e.preventDefault();
  });

  topicRows.addEventListener('drop', async (e) => {
    const targetRow = e.target.closest('[data-topic-row]');
    if (!targetRow || draggedTopicId === null || topicStatusFilter !== 'all') return;
    e.preventDefault();

    const targetId = Number(targetRow.dataset.topicRow);
    const fromIdx = currentTopics.findIndex((t) => t.id === draggedTopicId);
    const toIdx = currentTopics.findIndex((t) => t.id === targetId);
    draggedTopicId = null;
    if (fromIdx === -1 || toIdx === -1 || fromIdx === toIdx) return;

    const [moved] = currentTopics.splice(fromIdx, 1);
    currentTopics.splice(toIdx, 0, moved);
    renderTopicRows();

    // Captured once, up front — refreshSha's refetch inside withShaRetry
    // replaces currentTopics wholesale, which would otherwise clobber the
    // reorder the admin just did before a retry gets a chance to resend it.
    const desiredOrder = currentTopics.map((t) => t.id);

    const topicsPanel = document.querySelector('[data-tab-panel="topics"]');
    await withContainerLoading(topicsPanel, async () => {
      const res = await withShaRetry('topics', () =>
        api('topics-reorder', {
          method: 'POST',
          body: JSON.stringify({ order: desiredOrder, sha: currentTopicsSha }),
        })
      );
      if (!res.ok) {
        alert(await res.text());
      }
      await loadTopics();
    });
  });

  topicEditForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const topic = {
      id: Number(topicEditForm.querySelector('[data-tfield="id"]').value),
      category: topicEditForm.querySelector('[data-tfield="category"]').value,
      search_intent: topicEditForm.querySelector('[data-tfield="search_intent"]').value,
      article_title: topicEditForm.querySelector('[data-tfield="article_title"]').value,
      target_keyword: topicEditForm.querySelector('[data-tfield="target_keyword"]').value,
      priority: topicEditForm.querySelector('[data-tfield="priority"]').value,
      status: topicEditForm.querySelector('[data-tfield="status"]').value,
      publish_date: topicEditForm.querySelector('[data-tfield="publish_date"]').value,
      notes: topicEditForm.querySelector('[data-tfield="notes"]').value,
    };

    const submitBtn = topicEditForm.querySelector('button[type="submit"]');
    await withButtonLoading(submitBtn, async () => {
      const res = await withShaRetry('topics', () =>
        api('topics-save', { method: 'POST', body: JSON.stringify({ topic, sha: currentTopicsSha }) })
      );
      if (!res.ok) {
        topicEditError.textContent = await res.text();
        topicEditError.classList.remove('hidden');
        return;
      }
      topicEditPanel.classList.add('hidden');
      // A saved topic can land outside the currently-active status filter
      // (a new topic defaults to "Not started"; an edit can change the
      // status entirely) — without resetting the filter, the row the admin
      // just touched would silently vanish from the list with nothing on
      // screen to say the save actually succeeded.
      topicStatusFilter = 'all';
      topicStatusFilterSelect.value = 'all';
      await loadTopics();
    });
  });

  const renderRows = () => {
    if (currentArticles.length === 0) {
      rowsBody.innerHTML = `
        <tr>
          <td colspan="5" class="py-12 text-center text-muted">No articles yet.</td>
        </tr>
      `;
      return;
    }
    rowsBody.innerHTML = sortedForDisplay()
      .map(
        (a) => `
        <tr class="border-t border-border hover:bg-bg-alt/60 transition-colors">
          <td class="py-3 px-4 max-w-[280px] truncate" title="${escapeHtml(a.title)}">${escapeHtml(a.title)}</td>
          <td class="py-3 px-4">
            <span class="text-[0.7rem] font-semibold uppercase px-2 py-0.5 rounded-full ${a.status === 'draft' ? 'bg-bg-alt text-muted' : 'bg-accent/10 text-accent-dark'}">${a.status === 'draft' ? 'Draft' : 'Published'}</span>
          </td>
          <td class="py-3 px-4 text-muted">${escapeHtml(a.category || '—')}</td>
          <td class="py-3 px-4 text-muted whitespace-nowrap">${escapeHtml(formatAdminDate(a.published_date))}</td>
          <td class="py-3 px-4">
            <div class="flex flex-wrap items-center gap-1.5">
              <button type="button" data-edit="${escapeHtml(a.slug)}" class="rounded-full border border-border px-2.5 py-1 text-[0.78rem] font-semibold text-ink hover:bg-bg-alt transition-colors">Edit</button>
              <button type="button" data-toggle="${escapeHtml(a.slug)}" class="rounded-full border border-border px-2.5 py-1 text-[0.78rem] font-semibold text-accent-dark hover:bg-accent/10 transition-colors">${a.status === 'draft' ? 'Publish' : 'Unpublish'}</button>
              <a href="/posts/${escapeHtml(a.slug)}" target="_blank" class="rounded-full border border-border px-2.5 py-1 text-[0.78rem] font-semibold text-ink hover:bg-bg-alt transition-colors">Preview</a>
              <button type="button" data-delete="${escapeHtml(a.slug)}" class="rounded-full border border-red-200 px-2.5 py-1 text-[0.78rem] font-semibold text-red-600 hover:bg-red-50 transition-colors">Delete</button>
            </div>
          </td>
        </tr>
      `
      )
      .join('');
  };

  const loadArticles = async () => {
    statusMsg.textContent = 'Loading…';
    const res = await api('admin-list');
    if (!res.ok) {
      statusMsg.textContent = 'Failed to load articles.';
      return false;
    }
    const data = await res.json();
    currentArticles = data.articles;
    currentSha = data.sha;
    statusMsg.textContent = `${currentArticles.length} article(s)`;
    renderRows();
    return true;
  };

  passwordInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') loginBtn.click();
  });

  loginBtn.addEventListener('click', () =>
    withButtonLoading(loginBtn, async () => {
      sessionStorage.setItem(PASSWORD_KEY, passwordInput.value);
      const res = await api('admin-list');
      if (!res.ok) {
        if (res.status === 429) {
          const retryAfterSec = Number(res.headers.get('Retry-After'));
          const retryMsg = Number.isFinite(retryAfterSec) && retryAfterSec > 0
            ? ` Try again in ${Math.ceil(retryAfterSec / 60)} min.`
            : ' Try again later.';
          loginError.textContent = `Too many failed attempts.${retryMsg}`;
        } else {
          loginError.textContent = 'Wrong password.';
        }
        loginError.classList.remove('hidden');
        sessionStorage.removeItem(PASSWORD_KEY);
        return;
      }
      const data = await res.json();
      currentArticles = data.articles;
      currentSha = data.sha;
      loginError.classList.add('hidden');
      loginPanel.classList.add('hidden');
      adminPanel.classList.remove('hidden');
      statusMsg.textContent = `${currentArticles.length} article(s)`;
      renderRows();
    })
  );

  refreshBtn.addEventListener('click', () => withButtonLoading(refreshBtn, () => tabLoaders[getActiveTab()]()));
  sortSelect.addEventListener('change', renderRows);
  topicStatusFilterSelect.addEventListener('change', () => {
    topicStatusFilter = topicStatusFilterSelect.value;
    renderTopicRows();
  });

  // Same-tab, same-origin content the admin already controls (and which the
  // real article page renders raw via set:html) — no new sanitization need.
  const updatePreview = () => {
    previewTitle.textContent = editForm.querySelector('[data-field="title"]').value || '(untitled)';
    previewBody.innerHTML = editForm.querySelector('[data-field="content_html"]').value || '';
  };

  // <input type="datetime-local"> requires a "YYYY-MM-DDTHH:mm" value —
  // a bare "YYYY-MM-DD" (every article published before this field could
  // carry a time) silently fails to populate the input at all. Pad it to
  // midnight so old entries still show up filled in; the user only sees
  // a time if they actually set one, since saving without touching the
  // field keeps sending this same padded value straight through.
  const toDatetimeLocalValue = (value) => {
    if (!value) return '';
    return value.includes('T') ? value : `${value}T00:00`;
  };

  // Guards against a poll loop from a previous article still running after
  // the admin switches to editing a different one, or cancels out entirely.
  let regenPollTimer = null;
  let regenSlug = null;
  const stopRegenPolling = () => {
    clearTimeout(regenPollTimer);
    regenPollTimer = null;
  };
  const resetRegenPanel = () => {
    stopRegenPolling();
    regenPanel.classList.add('hidden');
    regenImageBtn.classList.remove('hidden');
    regenImageBtn.disabled = false;
    regenGenerateBtn.disabled = false;
    regenStatus.textContent = '';
  };

  const POLL_INTERVAL_MS = 3000;
  const POLL_MAX_ATTEMPTS = 40; // ~2 minutes

  const pollRegenStatus = async (slug, attempt = 1) => {
    if (regenSlug !== slug) return; // a newer regen (or a panel switch) superseded this poll
    const res = await api(`image-regen-status?slug=${encodeURIComponent(slug)}`);
    if (!res.ok) {
      regenStatus.textContent = await res.text();
      regenGenerateBtn.disabled = false;
      return;
    }
    const record = await res.json();

    if (record.status === 'done') {
      heroImage.src = `data:image/png;base64,${record.imageBase64}`;
      const article = currentArticles.find((a) => a.slug === slug);
      if (article) article.image_prompt = record.imagePrompt;
      regenStatus.textContent = record.promptSaveFailed
        ? 'Image committed, but saving the prompt text failed — re-open this article and try again if you want it saved.'
        : 'Done — new image committed. It will appear on the live site after the next deploy.';
      regenGenerateBtn.disabled = false;
      return;
    }

    if (record.status === 'error') {
      regenStatus.textContent = `Failed: ${record.error || 'unknown error'}`;
      regenGenerateBtn.disabled = false;
      return;
    }

    if (attempt >= POLL_MAX_ATTEMPTS) {
      regenStatus.textContent = 'Taking longer than expected — it may still finish in the background. Check back shortly.';
      regenGenerateBtn.disabled = false;
      return;
    }

    regenPollTimer = setTimeout(() => pollRegenStatus(slug, attempt + 1), POLL_INTERVAL_MS);
  };

  regenImageBtn.addEventListener('click', () => {
    const slug = editForm.querySelector('[data-field="slug"]').value;
    const article = currentArticles.find((a) => a.slug === slug);
    regenPrompt.value = article?.image_prompt || '';
    regenImageBtn.classList.add('hidden');
    regenPanel.classList.remove('hidden');
    regenStatus.textContent = '';
  });

  regenCancelBtn.addEventListener('click', () => {
    resetRegenPanel();
  });

  regenGenerateBtn.addEventListener('click', async () => {
    const slug = editForm.querySelector('[data-field="slug"]').value;
    const prompt = regenPrompt.value.trim();
    if (!prompt) {
      regenStatus.textContent = 'Prompt cannot be empty.';
      return;
    }
    stopRegenPolling();
    regenSlug = slug;
    regenGenerateBtn.disabled = true;
    regenStatus.textContent = 'Generating… this can take up to a minute.';
    const res = await api('image-regen-run-background', {
      method: 'POST',
      body: JSON.stringify({ slug, prompt }),
    });
    if (!res.ok) {
      regenStatus.textContent = await res.text();
      regenGenerateBtn.disabled = false;
      return;
    }
    pollRegenStatus(slug);
  });

  const openEdit = (slug) => {
    const article = currentArticles.find((a) => a.slug === slug);
    if (!article) return;
    editForm.querySelector('[data-field="slug"]').value = article.slug;
    editForm.querySelector('[data-field="title"]').value = article.title || '';
    editForm.querySelector('[data-field="excerpt"]').value = article.excerpt || '';
    editForm.querySelector('[data-field="published_date"]').value = toDatetimeLocalValue(article.published_date);
    editForm.querySelector('[data-field="category"]').value = article.category || '';
    editForm.querySelector('[data-field="status"]').value = article.status === 'draft' ? 'draft' : 'published';
    editForm.querySelector('[data-field="content_html"]').value = article.content_html || '';
    heroImage.src = `/images/${article.slug}.png?t=${Date.now()}`;
    regenSlug = null;
    resetRegenPanel();
    editError.classList.add('hidden');
    editPanel.classList.remove('hidden');
    editPanel.scrollIntoView({ behavior: 'smooth' });
    updatePreview();
  };

  editForm.querySelector('[data-field="title"]').addEventListener('input', updatePreview);
  editForm.querySelector('[data-field="content_html"]').addEventListener('input', updatePreview);

  cancelEditBtn.addEventListener('click', () => {
    regenSlug = null;
    stopRegenPolling();
    editPanel.classList.add('hidden');
  });

  rowsBody.addEventListener('click', async (e) => {
    const editSlug = e.target.closest('[data-edit]')?.dataset.edit;
    const toggleBtn = e.target.closest('[data-toggle]');
    const deleteBtn = e.target.closest('[data-delete]');

    if (editSlug) {
      openEdit(editSlug);
      return;
    }

    if (toggleBtn) {
      const toggleSlug = toggleBtn.dataset.toggle;
      const article = currentArticles.find((a) => a.slug === toggleSlug);
      if (!article) return;
      const updated = { ...article, status: article.status === 'draft' ? 'published' : 'draft' };
      await withButtonLoading(toggleBtn, async () => {
        const res = await withShaRetry('articles', () =>
          api('admin-save', { method: 'POST', body: JSON.stringify({ article: updated, sha: currentSha }) })
        );
        if (!res.ok) {
          statusMsg.textContent = await res.text();
          return;
        }
        await loadArticles();
      });
      return;
    }

    if (deleteBtn) {
      const deleteSlug = deleteBtn.dataset.delete;
      if (!confirm(`Delete "${deleteSlug}"? This cannot be undone from here (use git revert to recover).`)) return;
      await withButtonLoading(deleteBtn, async () => {
        const res = await withShaRetry('articles', () =>
          api('admin-delete', { method: 'POST', body: JSON.stringify({ slug: deleteSlug, sha: currentSha }) })
        );
        if (!res.ok) {
          statusMsg.textContent = await res.text();
          return;
        }
        await loadArticles();
      });
    }
  });

  editForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const slug = editForm.querySelector('[data-field="slug"]').value;
    const original = currentArticles.find((a) => a.slug === slug) || {};
    const newPublishedDate = editForm.querySelector('[data-field="published_date"]').value;
    const newCategory = editForm.querySelector('[data-field="category"]').value;
    const article = {
      slug,
      title: editForm.querySelector('[data-field="title"]').value,
      excerpt: editForm.querySelector('[data-field="excerpt"]').value,
      published_date: newPublishedDate || original.published_date,
      category: newCategory || original.category,
      status: editForm.querySelector('[data-field="status"]').value,
      content_html: editForm.querySelector('[data-field="content_html"]').value,
    };
    const merged = { ...original, ...article };

    const submitBtn = editForm.querySelector('button[type="submit"]');
    await withButtonLoading(submitBtn, async () => {
      const res = await withShaRetry('articles', () =>
        api('admin-save', { method: 'POST', body: JSON.stringify({ article: merged, sha: currentSha }) })
      );
      if (!res.ok) {
        editError.textContent = await res.text();
        editError.classList.remove('hidden');
        return;
      }
      editPanel.classList.add('hidden');
      await loadArticles();
    });
  });

  if (getPassword()) {
    loadArticles().then((ok) => {
      if (ok) {
        loginPanel.classList.add('hidden');
        adminPanel.classList.remove('hidden');
      } else {
        sessionStorage.removeItem(PASSWORD_KEY);
      }
    });
  }
</script>
